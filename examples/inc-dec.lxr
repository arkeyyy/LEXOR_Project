SCRIPT AREA
    START SCRIPT
        DECLARE INT a, b, c, d

        a = 5
        b = 5

        c = ++a
        PRINT: "pre-increment a: " & a & $
        PRINT: "c = ++a:         " & c & $ & $

        d = b++
        PRINT: "post-increment b: " & b & $
        PRINT: "d = b++:          " & d & $ & $

        ++a
        b--
        PRINT: "standalone ++a: " & a & $
        PRINT: "standalone b--: " & b & $
    END SCRIPT
